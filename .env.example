# ────────────────────────────────────────────────────────────────
# Кварта · переменные окружения
# Скопируйте в .env.local и заполните. .env.local в git не попадает.
# ────────────────────────────────────────────────────────────────

# Публичный адрес сайта: нужен для canonical, OpenGraph и sitemap.
# На Vercel можно не задавать — подставится системный домен.
# Локально: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Telegram-уведомления о заявках.
# 1. Создайте бота через @BotFather → /newbot → получите токен.
# 2. Напишите своему боту /start.
# 3. Узнайте chat_id (например, через @userinfobot) и вставьте ниже.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Опционально: общий дедупликатор заявок на 10 минут для нескольких
# serverless-инстансов (Upstash Redis, REST API). Без него дедупликация
# работает в памяти инстанса — подробности в README.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
